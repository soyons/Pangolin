[Unit]
Description=RelayPilot relay server
After=network-online.target
Wants=network-online.target
[Service]
User=relaypilot
WorkingDirectory=/opt/RelayPilot
EnvironmentFile=/etc/relaypilot/server.env
ExecStart=/opt/RelayPilot/.venv/bin/uvicorn server.main:app --host 127.0.0.1 --port 8000 --workers 1 --ws-max-size 131072
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
