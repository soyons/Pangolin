[Unit]
Description=Pangolin outbound agent
After=network-online.target
Wants=network-online.target
[Service]
# Install as a user service for the account that owns the projects and CLI login.
WorkingDirectory=%h/Pangolin
EnvironmentFile=%h/.config/pangolin/agent.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=%h/Pangolin/.venv/bin/python -m agent.main
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
