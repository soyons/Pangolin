# Default account server. Email is an unverified account identifier; SMTP is not required.
PANGOLIN_AUTH_MODE=accounts
PANGOLIN_DATABASE=.pangolin/server.sqlite3
PANGOLIN_REGISTRATION=open
PANGOLIN_HISTORY_DAYS=30
# Set to the external HTTPS origin in production; loopback HTTP is for local development.
PANGOLIN_PUBLIC_URL=http://127.0.0.1:8000

# Legacy mode only (set PANGOLIN_AUTH_MODE=legacy explicitly).
# Generate distinct secrets before enabling legacy authentication.
# USER_TOKEN=REPLACE_WITH_RANDOM_USER_TOKEN
# DEVICE_TOKENS=devbox:REPLACE_WITH_RANDOM_DEVICE_TOKEN
# RELAY_WS_URL=ws://127.0.0.1:8000/ws/agent
# DEVICE_ID=devbox
# DEVICE_TOKEN=REPLACE_WITH_RANDOM_DEVICE_TOKEN
# AGENT_CONFIG=config/agent.local.yaml
